{
  "name": "@omnirush-ai/omnirush-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "sdk:generate": "pnpm --filter @omnirush/sdk generate",
    "sdk:check": "pnpm --filter @omnirush/sdk generate:check && pnpm --filter @omnirush/sdk typecheck",
    "sdk:build": "pnpm --filter @omnirush/sdk build",
    "dev": "OMNIRUSH_DEV_MODE=1 OMNIRUSH_BROWSER_AUTO_APPROVE=${OMNIRUSH_BROWSER_AUTO_APPROVE:-1} OMNIRUSH_ELECTRON_REMOTE_DEBUG_PORT=${OMNIRUSH_ELECTRON_REMOTE_DEBUG_PORT:-9823} pnpm --filter @omnirush/desktop dev",
    "dev:worktree": "OMNIRUSH_DEV_MODE=1 OMNIRUSH_BROWSER_AUTO_APPROVE=${OMNIRUSH_BROWSER_AUTO_APPROVE:-1} OMNIRUSH_DEV_PROFILE=auto OMNIRUSH_ELECTRON_USE_MOCK_KEYCHAIN=${OMNIRUSH_ELECTRON_USE_MOCK_KEYCHAIN:-1} OMNIRUSH_ELECTRON_REMOTE_DEBUG_PORT=0 PORT=0 pnpm --filter @omnirush/desktop dev",
    "dev:electron": "OMNIRUSH_DEV_MODE=1 OMNIRUSH_BROWSER_AUTO_APPROVE=${OMNIRUSH_BROWSER_AUTO_APPROVE:-1} pnpm --filter @omnirush/desktop dev:electron",
    "dev:sandbox": "bash .devcontainer/dev-sandbox.sh",
    "dev:ui": "OMNIRUSH_DEV_MODE=1 pnpm --filter @omnirush/app dev",
    "dev:ui-demo": "pnpm --filter @omnirush/ui-demo dev",
    "dev:web": "pnpm run dev:den:web",
    "dev:web-local": "pnpm run dev:den",
    "dev:den": "node scripts/dev-local.mjs",
    "dev:enterprise-mock-lab": "pnpm --filter @omnirush-ee/enterprise-mock-lab dev",
    "dev:diagnostics": "pnpm --filter @omnirush-ee/diagnostics dev",
    "dev:den-local": "pnpm run dev:den",
    "dev:den:mysql": "docker compose -p omnirush-den-local -f packaging/docker/docker-compose.web-local.yml up -d --wait mysql redis",
    "dev:den:mysql:down": "docker compose -p omnirush-den-local -f packaging/docker/docker-compose.web-local.yml down",
    "dev:den:db-push": "DATABASE_URL=${DATABASE_URL:-mysql://root:password@127.0.0.1:3306/omnirush_den} DEN_DB_ENCRYPTION_KEY=${DEN_DB_ENCRYPTION_KEY:-local-dev-db-encryption-key-please-change-1234567890} pnpm --filter @omnirush-ee/den-db db:push",
    "dev:den:api": "DEN_WEB_PORT=${DEN_WEB_PORT:-3005}; OMNIRUSH_APP_PORT=${OMNIRUSH_APP_PORT:-5173}; DEN_LOCAL_ORIGINS=http://localhost:$DEN_WEB_PORT,http://127.0.0.1:$DEN_WEB_PORT,http://localhost:$OMNIRUSH_APP_PORT,http://127.0.0.1:$OMNIRUSH_APP_PORT; OMNIRUSH_DEV_MODE=1 DEN_PASSWORD_BREACH_SCREENING_ENABLED=${DEN_PASSWORD_BREACH_SCREENING_ENABLED:-false} PORT=${DEN_API_PORT:-8790} DATABASE_URL=${DATABASE_URL:-mysql://root:password@127.0.0.1:3306/omnirush_den} DATABASE_REDIS_URL=${DATABASE_REDIS_URL:-redis://127.0.0.1:6379} DEN_DB_ENCRYPTION_KEY=${DEN_DB_ENCRYPTION_KEY:-local-dev-db-encryption-key-please-change-1234567890} BETTER_AUTH_SECRET=${BETTER_AUTH_SECRET:-local-dev-secret-not-for-production-use!!} DEN_BASE_URL=${DEN_BASE_URL:-http://localhost:$DEN_WEB_PORT} DEN_BETTER_AUTH_TRUSTED_ORIGINS=${DEN_BETTER_AUTH_TRUSTED_ORIGINS:-$DEN_LOCAL_ORIGINS} CORS_ORIGINS=${CORS_ORIGINS:-$DEN_LOCAL_ORIGINS} DEN_DIAGNOSTICS_ORIGIN=${DEN_DIAGNOSTICS_ORIGIN:-https://diagnostics.invalid} DEN_DIAGNOSTICS_BEARER_TOKEN=${DEN_DIAGNOSTICS_BEARER_TOKEN:-OmniRushDiagnosticsToken!} PROVISIONER_MODE=${PROVISIONER_MODE:-stub} pnpm --filter @omnirush-ee/den-api dev:local",
    "dev:den:inference": "DEN_WEB_PORT=${DEN_WEB_PORT:-3005}; OMNIRUSH_APP_PORT=${OMNIRUSH_APP_PORT:-5173}; INFERENCE_PORT=${INFERENCE_PORT:-8791}; DEN_LOCAL_ORIGINS=http://localhost:$DEN_WEB_PORT,http://127.0.0.1:$DEN_WEB_PORT,http://localhost:$OMNIRUSH_APP_PORT,http://127.0.0.1:$OMNIRUSH_APP_PORT; OMNIRUSH_DEV_MODE=1 PORT=$INFERENCE_PORT DATABASE_URL=${DATABASE_URL:-mysql://root:password@127.0.0.1:3306/omnirush_den} DEN_DB_ENCRYPTION_KEY=${DEN_DB_ENCRYPTION_KEY:-local-dev-db-encryption-key-please-change-1234567890} CORS_ORIGINS=${CORS_ORIGINS:-$DEN_LOCAL_ORIGINS} INFERENCE_PROXY_BASE_URL=${INFERENCE_PROXY_BASE_URL:-http://localhost:$INFERENCE_PORT} INFERENCE_ADMIN_TOKEN=${INFERENCE_ADMIN_TOKEN:-local-dev-admin-token} INFERENCE_WEBHOOK_SECRET=${INFERENCE_WEBHOOK_SECRET:-local-dev-webhook-secret} pnpm --filter @omnirush-ee/inference dev:local",
    "dev:den:web": "DEN_API_PORT=${DEN_API_PORT:-8790}; DEN_WEB_PORT=${DEN_WEB_PORT:-3005}; OMNIRUSH_DEV_MODE=1 NEXT_PUBLIC_POSTHOG_KEY= NEXT_PUBLIC_POSTHOG_API_KEY= DEN_API_BASE=${DEN_API_BASE:-http://localhost:$DEN_API_PORT} DEN_BASE_URL=${DEN_BASE_URL:-http://localhost:$DEN_WEB_PORT} DEN_AUTH_ORIGIN=${DEN_AUTH_ORIGIN:-http://localhost:$DEN_WEB_PORT} DEN_AUTH_FALLBACK_BASE=${DEN_AUTH_FALLBACK_BASE:-http://localhost:$DEN_API_PORT} pnpm --filter @omnirush-ee/den-web dev:local",
    "email:dev": "pnpm --filter @omnirush/email dev",
    "dev:den-docker": "bash packaging/docker/den-dev-up.sh",
    "dev:den:seed-demo": "pnpm --filter @omnirush-ee/den-api seed:demo-org",
    "dev:den:seed-demo:reset": "pnpm --filter @omnirush-ee/den-api run seed:demo-org -- --reset",
    "dev:headless-web": "OMNIRUSH_DEV_MODE=1 node scripts/dev-headless-web.ts",
    "build": "node scripts/build.mjs",
    "build:ui": "pnpm --filter @omnirush/app build",
    "build:web": "pnpm --filter @omnirush-ee/den-web build",
    "preview": "pnpm --filter @omnirush/app preview",
    "typecheck": "pnpm --filter @omnirush/app typecheck",
    "check:enterprise-mcp-mock-server": "pnpm --filter @omnirush/enterprise-mcp-mock-server check",
    "check:enterprise-mock-lab": "pnpm --filter @omnirush-ee/enterprise-mock-lab check",
    "check:diagnostics": "pnpm --filter @omnirush-ee/diagnostics test && pnpm --filter @omnirush-ee/diagnostics build",
    "test": "pnpm test:core",
    "test:health": "pnpm --filter @omnirush/app test:health",
    "test:sessions": "pnpm --filter @omnirush/app test:sessions",
    "test:refactor": "pnpm --filter @omnirush/app test:refactor",
    "test:events": "pnpm --filter @omnirush/app test:events",
    "test:todos": "pnpm --filter @omnirush/app test:todos",
    "test:permissions": "pnpm --filter @omnirush/app test:permissions",
    "test:session-error-recovery": "pnpm --filter @omnirush/app test:session-error-recovery",
    "test:session-scope": "pnpm --filter @omnirush/app test:session-scope",
    "test:session-switch": "pnpm --filter @omnirush/app test:session-switch",
    "test:fs-engine": "pnpm --filter @omnirush/app test:fs-engine",
    "test:eval-runner": "pnpm --dir evals run test",
    "check:outbound-access": "node scripts/check-outbound-access.mjs",
    "test:e2e": "pnpm --filter @omnirush/app test:e2e",
    "test:admin-scale": "pnpm --filter @omnirush-ee/den-api test:admin-scale",
    "benchmark:admin-scale:mysql": "pnpm --filter @omnirush-ee/den-db benchmark:admin-scale:mysql",
    "evals:e2e": "node evals/bin/evals.mjs",
    "evals:typecheck": "tsc -p evals",
    "evals:test": "pnpm --dir evals test",
    "evals:pr": "pnpm --dir evals run test:pr",
    "world": "node evals/bin/world.mjs",
    "release:review": "node scripts/release/review.mjs",
    "release:rollback": "node scripts/release/rollback.mjs",
    "release:cut": "node scripts/release/cut.mjs",
    "release:cut:watch": "node scripts/release/cut.mjs --watch",
    "test:core": "pnpm --filter @omnirush/app test:core && pnpm --filter omnirush-server test:core && pnpm --filter @omnirush-ee/den-api test && pnpm --filter @omnirush/desktop test:core && pnpm --dir evals run test:core",
    "test:extended": "pnpm --filter @omnirush/app test && pnpm --filter omnirush-server test && pnpm --filter @omnirush-ee/den-api test && pnpm --filter @omnirush/desktop test && node --test scripts/release/*.test.mjs && pnpm test:eval-runner && pnpm evals:pr && pnpm test:e2e",
    "evals:check-browser": "pnpm --dir evals check:browser"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.10.7",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.4.0"
}
