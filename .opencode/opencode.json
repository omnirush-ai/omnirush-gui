{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "model": "zai-coding-plan/glm-5.3",
  "provider": {
    "zai-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI Coding Plan",
      "env": ["ZAI_API_KEY"],
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM-5.3"
        }
      }
    }
  },
  "plugin": ["opencode-chrome-devtools@1.0.4"]
}
