{
  "name": "@omnirush/browser-logins",
  "private": true,
  "type": "module",
  "description": "Bring a browser profile into OmniRush.ai's built-in browser: source discovery, cookie readers and decryption, site grouping and sensitivity defaults, bookmarks and history readers.",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./node": {
      "types": "./node.d.ts",
      "default": "./node.mjs"
    },
    "./bookmarks": {
      "types": "./bookmarks.d.ts",
      "default": "./bookmarks.mjs"
    },
    "./history": {
      "types": "./history.d.ts",
      "default": "./history.mjs"
    },
    "./safari": {
      "types": "./safari.d.ts",
      "default": "./safari.mjs"
    },
    "./linux-keyring": {
      "types": "./linux-keyring.d.ts",
      "default": "./linux-keyring.mjs"
    }
  },
  "files": [
    "index.d.ts",
    "index.mjs",
    "node.d.ts",
    "node.mjs",
    "bookmarks.d.ts",
    "bookmarks.mjs",
    "history.d.ts",
    "history.mjs",
    "safari.d.ts",
    "safari.mjs",
    "linux-keyring.d.ts",
    "linux-keyring.mjs"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
